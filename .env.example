# data-layer-postgres — non-secret env template
# Real secrets belong in .a0proj/secrets.env (mode 0600, not committed).

# Connection — used by lib/install.sh for migrations
DATA_LAYER_POSTGRES_DSN=postgresql://postgres@localhost:5432/postgres

# Cluster installer — required, lib/postgres.sh fails fast if blank
POSTGRES_PASSWORD=

# Cluster paths (defaults match Debian/Ubuntu PG18 install)
PERSISTENCE_DATA_DIR=/var/lib/postgresql
PERSISTENCE_CONFIG_DIR=/etc/persistence