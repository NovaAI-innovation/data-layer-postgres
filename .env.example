# data-layer-postgres — non-secret env template
# Real secrets belong in .a0proj/secrets.env (mode 0600, not committed).

# Connection — used by lib/install.sh for migrations. The az-postgres
# container listens on host 127.0.0.1:5432 via docker port forwarding.
DATA_LAYER_POSTGRES_DSN=postgresql://postgres:postgres_dev_password@127.0.0.1:5432/postgres

# postgres superuser password. Must match the POSTGRES_PASSWORD env var
# passed to the az-postgres container at run time.
POSTGRES_PASSWORD=postgres_dev_password

# agent_zero role password (per-tenant login role). Default is
# test-data only; rotate before any non-test deployment. Set this
# via CREATE ROLE agent_zero WITH LOGIN PASSWORD '...'; on the
# running container (one-shot init SQL).
DATA_LAYER_AGENT_ZERO_PASSWORD=agent_zero_dev_password

# az-postgres container env (set at docker run time, NOT in lib/install.sh).
# See README.md "Container env vars" for the full list.
# AZ_POSTGRES_IMAGE=pgvector/pgvector:pg16
# AZ_POSTGRES_CONTAINER=az-postgres
# AZ_POSTGRES_VOLUME=az-postgres-data
# AZ_POSTGRES_PORT=5432